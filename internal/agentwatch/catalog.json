{
  "version": "2026-10-20",
  "note": "Known AI agents for Agent Watch. Seeded from the Microsoft Defender for Endpoint local-agent support list. Process names and paths are best-effort and still need checking on a real Windows machine. Users can override this file by copying it to ~/.devshield/agent_catalog.json. Matching: an entry matches a process when any cmdline_patterns regex matches the command line, or when the process name is in process_names and (path_patterns is empty or one of them matches the exe path). Entries are checked in order; the first match wins, so put specific entries before general ones. All regexes are case-insensitive.",
  "agents": [
    { "name": "VS Code Claude Code Extension", "vendor": "Anthropic", "kind": "extension",
      "cmdline_patterns": ["[\\\\/]extensions[\\\\/]anthropic\\.claude-code"] },
    { "name": "VS Code Cline Extension", "vendor": "Cline", "kind": "extension",
      "cmdline_patterns": ["[\\\\/]extensions[\\\\/]saoudrizwan\\.claude-dev"] },
    { "name": "VS Code Roo Code Extension", "vendor": "Roo Code", "kind": "extension",
      "cmdline_patterns": ["[\\\\/]extensions[\\\\/]rooveterinaryinc\\.roo-cline"] },
    { "name": "VS Code Codex Extension", "vendor": "OpenAI", "kind": "extension",
      "cmdline_patterns": ["[\\\\/]extensions[\\\\/]openai\\.chatgpt"] },
    { "name": "VS Code Gemini Code Assist Extension", "vendor": "Google", "kind": "extension",
      "cmdline_patterns": ["[\\\\/]extensions[\\\\/]google\\.geminicodeassist"] },
    { "name": "VS Code GitHub Copilot Extension", "vendor": "GitHub", "kind": "extension",
      "cmdline_patterns": ["[\\\\/]extensions[\\\\/]github\\.copilot"] },

    { "name": "Claude Desktop", "vendor": "Anthropic", "kind": "desktop",
      "process_names": ["claude.exe"],
      "path_patterns": ["anthropicclaude", "[\\\\/]programs[\\\\/]claude[\\\\/]", "windowsapps[\\\\/]claude"] },
    { "name": "Claude Code", "vendor": "Anthropic", "kind": "cli",
      "process_names": ["claude.exe", "claude"],
      "cmdline_patterns": ["@anthropic-ai[\\\\/]claude-code"] },
    { "name": "Codex", "vendor": "OpenAI", "kind": "cli",
      "process_names": ["codex.exe", "codex"],
      "cmdline_patterns": ["@openai[\\\\/]codex"] },
    { "name": "Gemini CLI", "vendor": "Google", "kind": "cli",
      "process_names": ["gemini.exe"],
      "cmdline_patterns": ["@google[\\\\/]gemini-cli"] },
    { "name": "GitHub Copilot CLI", "vendor": "GitHub", "kind": "cli",
      "cmdline_patterns": ["@github[\\\\/]copilot"] },
    { "name": "Amp CLI", "vendor": "Amp", "kind": "cli",
      "process_names": ["amp.exe"],
      "cmdline_patterns": ["@sourcegraph[\\\\/]amp"] },
    { "name": "Qwen Code", "vendor": "Alibaba Cloud", "kind": "cli",
      "cmdline_patterns": ["@qwen-code[\\\\/]qwen-code"] },
    { "name": "OpenCode", "vendor": "Anomaly", "kind": "cli",
      "process_names": ["opencode.exe"],
      "cmdline_patterns": ["opencode-ai[\\\\/]", "[\\\\/]opencode(\\.exe)?(\\s|\"|$)"] },
    { "name": "Goose", "vendor": "Agentic AI Foundation", "kind": "cli",
      "process_names": ["goose.exe", "goosed.exe"] },
    { "name": "Cline CLI", "vendor": "Cline", "kind": "cli",
      "process_names": ["cline.exe"] },
    { "name": "Kiro", "vendor": "Amazon", "kind": "ide",
      "process_names": ["kiro.exe", "kiro-cli.exe"] },
    { "name": "Aider", "vendor": "Aider", "kind": "cli",
      "process_names": ["aider.exe"],
      "cmdline_patterns": ["-m\\s+aider(\\s|$)", "[\\\\/]aider(\\.exe)?(\\s|\"|$)"] },
    { "name": "Open Interpreter", "vendor": "Open Interpreter", "kind": "cli",
      "process_names": ["interpreter.exe"] },
    { "name": "OpenClaw", "vendor": "OpenClaw Foundation", "kind": "cli",
      "process_names": ["openclaw.exe"],
      "cmdline_patterns": ["openclaw"] },

    { "name": "Cursor", "vendor": "Anysphere", "kind": "ide",
      "process_names": ["cursor.exe"] },
    { "name": "Windsurf", "vendor": "Cognition", "kind": "ide",
      "process_names": ["windsurf.exe"] },
    { "name": "Antigravity", "vendor": "Google", "kind": "ide",
      "process_names": ["antigravity.exe"] },
    { "name": "Trae IDE", "vendor": "ByteDance", "kind": "ide",
      "process_names": ["trae.exe"] },
    { "name": "Warp", "vendor": "Warp", "kind": "desktop",
      "process_names": ["warp.exe"] },
    { "name": "ChatGPT Desktop", "vendor": "OpenAI", "kind": "desktop",
      "process_names": ["chatgpt.exe"] },
    { "name": "Perplexity Desktop", "vendor": "Perplexity", "kind": "desktop",
      "process_names": ["perplexity.exe"] },
    { "name": "Microsoft Copilot app", "vendor": "Microsoft", "kind": "desktop",
      "process_names": ["copilot.exe", "m365copilot.exe"] },

    { "name": "Ollama", "vendor": "Ollama", "kind": "runtime",
      "process_names": ["ollama.exe", "ollama app.exe", "ollama"],
      "ports": [11434] },
    { "name": "LM Studio", "vendor": "Element Labs", "kind": "runtime",
      "process_names": ["lm studio.exe", "lms.exe"],
      "ports": [1234] },
    { "name": "Jan", "vendor": "Menlo Research", "kind": "runtime",
      "process_names": ["jan.exe"],
      "ports": [1337] },
    { "name": "llama.cpp server", "vendor": "ggml", "kind": "runtime",
      "process_names": ["llama-server.exe", "llama-server"],
      "ports": [8080] },
    { "name": "Foundry Local", "vendor": "Microsoft", "kind": "runtime",
      "process_names": ["foundry.exe"] },

    { "name": "MCP server", "vendor": "", "kind": "mcp_server",
      "cmdline_patterns": ["@modelcontextprotocol[\\\\/]", "[\\w.-]*mcp-server[\\w.-]*", "\\bmcp\\b.*--stdio", "(uvx|npx)(\\.cmd|\\.exe)?\"?\\s+[^\\s]*mcp"] }
  ],

  "llm_api_hosts": [
    "api.anthropic.com",
    "api.openai.com",
    "generativelanguage.googleapis.com",
    "api.mistral.ai",
    "api.groq.com",
    "api.together.xyz",
    "api.deepseek.com",
    "api.x.ai",
    "api.perplexity.ai",
    "openrouter.ai",
    "api.cohere.com",
    "api-inference.huggingface.co"
  ],

  "llm_env_vars": [
    "OPENAI_API_KEY", "OPENAI_BASE_URL", "OPENAI_API_BASE", "AZURE_OPENAI_API_KEY", "AZURE_OPENAI_ENDPOINT",
    "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX",
    "GEMINI_API_KEY", "GOOGLE_API_KEY", "GOOGLE_GENAI_USE_VERTEXAI",
    "MISTRAL_API_KEY", "GROQ_API_KEY", "DEEPSEEK_API_KEY", "XAI_API_KEY", "TOGETHER_API_KEY", "COHERE_API_KEY",
    "OPENROUTER_API_KEY", "PERPLEXITY_API_KEY", "FIREWORKS_API_KEY", "HF_TOKEN", "HUGGINGFACEHUB_API_TOKEN",
    "OLLAMA_HOST", "LITELLM_*", "LANGCHAIN_*", "LANGSMITH_*"
  ],

  "ai_libraries": [
    { "pattern": "ggml",             "label": "llama.cpp / ggml",    "weight": 3 },
    { "pattern": "llama",            "label": "llama.cpp",           "weight": 3 },
    { "pattern": "whisper",          "label": "whisper.cpp",         "weight": 2 },
    { "pattern": "ctranslate2",      "label": "CTranslate2",         "weight": 3 },
    { "pattern": "mlc_llm",          "label": "MLC LLM",             "weight": 3 },
    { "pattern": "onnxruntime-genai","label": "ONNX Runtime GenAI",  "weight": 3 },
    { "pattern": "torch_cpu",        "label": "PyTorch",             "weight": 2 },
    { "pattern": "torch_cuda",       "label": "PyTorch (CUDA)",      "weight": 2 },
    { "pattern": "openvino",         "label": "OpenVINO",            "weight": 2 },
    { "pattern": "tensorflow",       "label": "TensorFlow",          "weight": 2 },
    { "pattern": "onnxruntime",      "label": "ONNX Runtime",        "weight": 1 }
  ],

  "agent_keywords": [
    "modelcontextprotocol", "mcp-server", "langchain", "langgraph", "autogen", "crewai",
    "openai-agents", "claude-agent-sdk", "anthropic", "ollama", "llama_cpp", "llama-cpp",
    "vllm", "smolagents", "browser-use", "computer-use", "agentic"
  ],

  "shell_names": ["pwsh.exe", "powershell.exe", "cmd.exe", "bash.exe", "sh.exe", "wsl.exe", "bash", "sh", "zsh", "dash", "fish", "pwsh"],

  "tool_processes": [
    "git.exe", "curl.exe", "wget.exe", "python.exe", "python3.exe", "node.exe", "npm.cmd", "npx.cmd",
    "rg.exe", "grep.exe", "findstr.exe", "where.exe", "tasklist.exe", "taskkill.exe", "ipconfig.exe",
    "ssh.exe", "scp.exe", "tar.exe", "7z.exe", "robocopy.exe", "xcopy.exe", "icacls.exe",
    "whoami.exe", "net.exe", "net1.exe", "netstat.exe", "nltest.exe", "systeminfo.exe", "reg.exe",
    "schtasks.exe", "sc.exe", "wmic.exe", "certutil.exe", "bitsadmin.exe", "vssadmin.exe", "cmdkey.exe",
    "rundll32.exe", "regsvr32.exe", "mshta.exe", "wscript.exe", "cscript.exe", "netsh.exe",
    "git", "curl", "wget", "python3", "node", "rg", "grep", "ssh", "whoami",
    "dash", "fish", "zsh", "id", "sudo", "crontab", "systemctl", "nc", "ncat", "socat", "iptables", "nft", "useradd", "passwd", "chmod", "scp", "make"
  ],

  "sensitive_tools": [
    "whoami.exe", "net.exe", "net1.exe", "nltest.exe", "systeminfo.exe", "reg.exe", "schtasks.exe", "sc.exe",
    "wmic.exe", "certutil.exe", "bitsadmin.exe", "vssadmin.exe", "cmdkey.exe", "rundll32.exe", "regsvr32.exe",
    "mshta.exe", "wscript.exe", "cscript.exe", "netsh.exe", "icacls.exe", "whoami",
    "id", "sudo", "crontab", "systemctl", "nc", "ncat", "socat", "iptables", "nft", "useradd", "passwd"
  ],

  "terminal_hosts": [
    "windowsterminal.exe", "openconsole.exe", "conhost.exe", "explorer.exe", "wezterm-gui.exe", "alacritty.exe",
    "gnome-terminal-", "gnome-terminal-server", "konsole", "xterm", "kitty", "tmux: server", "screen", "sshd"
  ],

  "risky_flags": [
    "--dangerously-skip-permissions", "--dangerously-bypass-approvals-and-sandbox", "bypassPermissions",
    "--yolo", "--full-auto", "--auto-approve", "--no-confirm", "--trust-all-tools", "--allow-all-tools"
  ],

  "unusual_paths": [
    "[\\\\/]appdata[\\\\/]local[\\\\/]temp[\\\\/]", "[\\\\/]windows[\\\\/]temp[\\\\/]", "[\\\\/]downloads[\\\\/]",
    "[\\\\/]users[\\\\/]public[\\\\/]", "\\$recycle\\.bin", "^/tmp/", "^/dev/shm/"
  ],

  "ignore_processes": [
    "devshield.exe", "chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "opera.exe", "vivaldi.exe",
    "svchost.exe", "system", "registry", "explorer.exe", "searchhost.exe", "msmpeng.exe"
  ]
}
