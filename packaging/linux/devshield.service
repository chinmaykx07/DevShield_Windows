# DevShield privileged daemon (Linux).
# Owns the sanction list, agent database and tamper-evident audit log in a
# root-only state directory, and runs Agent Watch over every user's processes.
#
# Configure the owner (who may READ status/agents/events without sudo) in
# /etc/devshield/daemon.env:   DEVSHIELD_OWNER=alice
# Changing policy (sanction/revoke/block/lockdown/…) always requires root:
# sudo devshield …   Network controls need the nft tool (package nftables).
[Unit]
Description=DevShield daemon — keeps this machine under its owner's control
Documentation=https://github.com/chinmaykx07/DevShield_Windows/blob/main/docs/USER_MANUAL.md

[Service]
Type=simple
EnvironmentFile=-/etc/devshield/daemon.env
ExecStart=/usr/bin/devshield daemon --owner ${DEVSHIELD_OWNER}
Restart=always
RestartSec=2

# Root-only state and the client socket directory
StateDirectory=devshield
StateDirectoryMode=0700
RuntimeDirectory=devshield
RuntimeDirectoryMode=0755
UMask=0077

# ── Hardening ───────────────────────────────────────────────────────────
# Only what Agent Watch needs: read every process's environment, loaded
# libraries and executable (CAP_SYS_PTRACE), and read users' autostart
# files (CAP_DAC_READ_SEARCH). Network quarantine/lockdown load DevShield's
# own nftables table (CAP_NET_ADMIN). Unblocking puts an agent's processes
# back into their original cgroup, which systemd often delegates to the
# user (their cgroup.procs is user-owned), so writing it needs
# CAP_DAC_OVERRIDE; without it DevShield falls back to the root cgroup and
# says so (EGRESS_RELEASE_FALLBACK). Not yet verified under systemd.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
# The only places outside the state directory DevShield writes: the
# telemetry sinkhole's managed block in /etc/hosts, and its own drop-in
# files for LAN privacy. Everything else under /etc stays read-only. The
# drop-in directories are created first (with full privileges, "+") so they
# can be bind-mounted writable; "-" skips NetworkManager's if it is absent.
ExecStartPre=+/bin/mkdir -p /etc/systemd/resolved.conf.d /etc/sysctl.d
ReadWritePaths=/etc/hosts /etc/systemd/resolved.conf.d /etc/sysctl.d -/etc/NetworkManager/conf.d
ProtectHome=read-only
# No PrivateTmp: rogue agents often live in /tmp, and the daemon must see
# (and hash) the real files there.
# ProtectKernelTunables is deliberately NOT set: it makes /sys read-only,
# and thermal profiles must write /sys/devices/system/cpu/cpufreq and
# /sys/firmware/acpi/platform_profile. ProtectSystem=strict leaves /sys
# writable while keeping the rest of the OS read-only.
ProtectKernelModules=yes
ProtectKernelLogs=yes
# ProtectControlGroups is deliberately NOT set: it makes /sys/fs/cgroup
# read-only, and "devshield block" must create the devshield-quarantine
# group and move the agent's processes into it.
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
